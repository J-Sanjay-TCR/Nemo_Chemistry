# Copy to .env (never commit it) or set these as secrets in your host.
# In Google AI Studio Build, add GEMINI_API_KEY under Settings > Secrets instead of using a file.
GEMINI_API_KEY=
# Optional: model id. Default is the alias gemini-flash-latest; server.js retries stable ids if it is rejected.
GEMINI_MODEL=gemini-flash-latest
# Optional alternative provider:
# ANTHROPIC_API_KEY=
